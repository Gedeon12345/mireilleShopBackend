PORT=5000
# MongoDB Atlas (les transactions exigent un replica set, Atlas en fournit un)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/shoe-inventory
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire-de-32-caracteres-minimum
JWT_EXPIRES_IN=7d
# URL(s) du frontend autorisées par CORS, séparées par des virgules
FRONTEND_URL=http://localhost:5173
# Photos (facultatif) : Cloudinary > Dashboard > API Environment variable
CLOUDINARY_URL=
# Décalage horaire de la boutique pour "ventes du jour" (Douala = UTC+1 = 60)
TZ_OFFSET_MINUTES=60
# Utilisés uniquement par "npm run init" (création du premier administrateur)
ADMIN_NAME=Administrateur
ADMIN_EMAIL=
ADMIN_PASSWORD=
